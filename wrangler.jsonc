{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caldas-ready-to-invest",
  "account_id": "f794f22f06232c1e70b2f011ba286a94",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "caldasreadytoinvest.pt",
      "custom_domain": true
    },
    {
      "pattern": "www.caldasreadytoinvest.pt",
      "custom_domain": true
    }
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caldas-ready-to-invest",
      "database_id": "be334575-6f12-4f5e-9e05-6fe1967e43f6",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
